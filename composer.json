{
    "name": "relicsoftware/barakah-payment-gateway",
    "description": "Official Laravel Payment Gateway SDK for Barakah Institutional Financial Wallet",
    "keywords": ["laravel", "barakah", "payment", "gateway", "bkash", "nagad", "fintech", "wallet"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Relic Software",
            "email": "support@relicsoftware.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "RelicSoftware\\BarakahPayment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RelicSoftware\\BarakahPayment\\BarakahPaymentServiceProvider"
            ],
            "aliases": {
                "Barakah": "RelicSoftware\\BarakahPayment\\Facades\\Barakah"
            }
        }
    },
    "minimum-stability": "stable"
}

